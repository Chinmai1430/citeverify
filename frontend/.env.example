# FastAPI backend base URL (local dev or Render production URL)
VITE_API_URL=http://127.0.0.1:8000

# Optional: Supabase Auth (Email + Google OAuth) & PostgreSQL Cloud History
# Leave blank to run in local Guest/Session fallback mode
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here