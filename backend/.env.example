# Required: Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model overrides
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_SECONDARY_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Polite-pool contact email for OpenAlex & Unpaywall APIs
UNPAYWALL_EMAIL=your_email@example.com
CONTACT_EMAIL=your_email@example.com

# Optional: Set to 1 to skip live OpenAlex/CrossRef temporal lookups (offline mode)
DISABLE_LIVE_TEMPORAL_FETCH=0